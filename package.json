{
  "name": "giapha-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next build --webpack",
    "cf:build": "npm run build && NEXT_IGNORE_INCORRECT_LOCKFILE=1 opennextjs-cloudflare build --skipNextBuild",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "deploy": "npm run cf:build && npm run cf:deploy",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tailwindcss/postcss": "^4.2.1",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "lunar-javascript": "^1.7.7",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.2.1",
    "wrangler": "^4.68.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.1.6",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.31.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
